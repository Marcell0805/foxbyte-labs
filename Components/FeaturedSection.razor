@using FoxbyteLabs.Services

<section class="door-featured" aria-labelledby="featured-heading">
    <div class="door-featured__copy">
        <p class="door-kicker">Featured product</p>
        <h2 id="featured-heading">F.F.S — Financial Forecasting System</h2>
        <p>
            A local-first personal finance application for tracking money,
            budgets, goals, reports and more.
        </p>
        <ul class="door-featured__facts">
            <li><Mark Name="android" /><span>Android</span></li>
            <li><Mark Name="layers" /><span>v1.1.0 <small>(Build 24)</small></span></li>
            <li><Mark Name="size" /><span>88.7 MB</span></li>
        </ul>
        <a class="btn btn--primary" href="@ProjectService.FfsUrl" target="_blank" rel="noopener noreferrer">
            View F.F.S <span aria-hidden="true">→</span>
        </a>
    </div>
    <div class="door-phones" aria-hidden="true">
        <div class="door-phone"><img src="images/featured/ffs-home.png" alt="" /></div>
        <div class="door-phone"><img src="images/featured/ffs-transactions.png" alt="" /></div>
        <div class="door-phone"><img src="images/featured/ffs-goals.png" alt="" /></div>
    </div>
</section>
